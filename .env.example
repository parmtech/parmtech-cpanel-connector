NODE_ENV=production
PUBLIC_BASE_URL=https://mcp.example.com
COMPANY_SITE_URL=https://parmtech.au/
SETUP_OWNER_EMAIL=owner@example.com
# For a private installation, restrict additional profile registration too.
REGISTRATION_ALLOWED_EMAILS=owner@example.com
TRUST_PROXY=false
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_ENCODED_AS_BASE64
POSTGRES_DB=parmtech
POSTGRES_USER=parmtech
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Email/password profile registration is disabled until SMTP is configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=PARMTECH Connector <connector@example.com>
# On cPanel, MAIL_TRANSPORT=sendmail may be used instead of SMTP credentials.
# Keep SMTP as the default on Docker hosts without a local mail server.

# Optional private, absolute staging directories. Docker Compose provides
# writable /tmp locations; its staging is temporary and clears on restart.
# PRIVATE_UPLOAD_DIR=/absolute/private/cpanel-uploads
# PRIVATE_PLAY_BUNDLE_DIR=/absolute/private/play-bundles

# Optional same-server direct downloads. Enable all three together only when
# the connector host can read that hosting account's dedicated export root.
# LOCAL_DOWNLOAD_ROOT=/absolute/private/export-root
# LOCAL_DOWNLOAD_CPANEL_HOST=hosting.example.com
# LOCAL_DOWNLOAD_CPANEL_USERNAME=your_cpanel_username
